# Build output
/bin/
/dist/
*.exe
*.exe~
*.dll
*.so
*.dylib

# Go test / coverage / profiling
*.test
*.out
coverage.*
/coverage/

# Go workspace
go.work
go.work.sum

# Model artifacts — large, not source
*.gguf
*.safetensors
/models/
~/.thlibo/models/

# Secrets and credentials
.env
.env.*
*.pem
*.key
*.p12
*.pfx
*.jks
*.gpg
*.asc
*secret*
# ...except signpost's generated pages, which are named after the concept
# they describe: the `secret-scanning` CI job becomes
# .signpost/pipelines/ci-secret-scanning.md, and ignoring it leaves the
# committed bundle short a page that index.md links to.
!/.signpost/**/*secret*.md
id_rsa
id_rsa.*
id_ecdsa
id_ecdsa.*
id_ed25519
id_ed25519.*
credentials.json
secrets.yaml

# IDE / OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Test sandboxes
.thlibo-test/
/.test/
/tmp/
.tmp/

# Local reference material (docs you've stashed for me to read)
.references/

# Agent-readiness scan output (local only — cites internal taxonomy; keep
# out of this public repo)
.ai-readiness/

# Python (script processors)
__pycache__/
*.pyc
*.pyo

# Local working notes (stashed alongside repo, not source)
.notes/
.tmp-review.diff

# govulncheck JSON, written by the CI scanners job (see ci.yml)
vulns.json
